{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hydrate",
  "version": "0.1.4",
  "identifier": "com.hydrate.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "docker compose up -d",
    "beforeBuildCommand": "npm run check"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hydrate",
        "width": 430,
        "height": 850,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "mini",
        "title": "Hydrate",
        "url": "index.html#mini",
        "width": 320,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
